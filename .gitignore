# Virtualenvs
embed_env/
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# Qdrant's on-disk state (recreated by docker run)
qdrant_storage/

# Pipeline artifacts — regenerate with 01_extract.py / 02_chunk.py
data/extracted.txt
data/chunks.json

# The bundled reference corpus (data/ndmo_framework.pdf) IS tracked, so the
# pipeline runs on clone. Ignore any other PDFs you drop in while swapping
# corpora — see config.py.
data/*.pdf
!data/ndmo_framework.pdf

# OS noise
.DS_Store
